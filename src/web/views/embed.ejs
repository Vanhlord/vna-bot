                    </div>
                <% } else { %>
                    <% playlists.forEach((pl) => { %>
                        <div class="playlist-card" onclick="loadPlaylistDetails('<%= pl.name %>')">
                            <div>
                                <div class="playlist-name">🎵 <%= pl.name %></div>
                                <div class="playlist-meta">
