                <div>
                    <div style="font-size: 16.5px; font-weight: 800; color: #fff;">✨ Tạo Danh Sách Nhạc Mới Ngay Tại Đây:</div>
                    <p style="color: var(--text-muted); font-size: 13px; margin-top: 2px;">
                        Đặt tên playlist ngắn gọn (ví dụ: <code>nhac_chill</code>, <code>gaming_top</code>, <code>edm_remix</code>).
                    </p>
                </div>
                <form onsubmit="handleInlineCreatePlaylist(event)" style="display: flex; gap: 10px; width: 100%; max-width: 480px;">
                    <input id="inline-pl-name" type="text" class="form-input" placeholder="Nhập tên playlist mới..." required>
                    <button type="submit" class="btn btn-success" style="white-space: nowrap;">Tạo Ngay ➕</button>
                </form>
            </div>
        </div>

        <!-- Playlists Cards Grid -->
        <div class="card">
