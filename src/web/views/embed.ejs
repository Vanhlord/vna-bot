                    </form>
                </div>
            </div>

            <!-- Right: Queue Table -->
            <div>
                <div class="card" style="height: 100%; display: flex; flex-direction: column;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <div style="font-weight: 800; font-size: 16px;">
                            📜 Hàng Đợi Bài Hát (<span id="queue-count">0</span> bài)
                        </div>
                        <button class="btn btn-danger btn-sm" onclick="clearQueue()">🗑️ Xóa Hết</button>
                    </div>

                    <div style="flex: 1; max-height: 400px; overflow-y: auto; border: 1px solid var(--border-subtle); border-radius: var(--radius-md);">
                        <table class="queue-table">
                            <thead>
                                <tr>
                                    <th style="width: 45px;">STT</th>
                                    <th>Bài Hát</th>
                                    <th>Thời lượng</th>
                                    <th style="width: 45px;">Xóa</th>
                                </tr>
                            </thead>
                            <tbody id="queue-tbody">
                                <tr>
                                    <td colspan="4" style="text-align: center; color: var(--text-sub); padding: 30px;">
                                        Hàng đợi trống. Nhập bài hát để phát tiếp nối!
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ====================================================
         PHẦN 2: TẠO & QUẢN LÝ PLAYLIST ("bên trong có phần tạo playlist")
    ==================================================== -->
