        <div class="section-header">
            <div class="section-badge-title">
                <div class="badge-num">2</div>
                <div>
                    <h2 class="section-title">📚 Tạo & Quản Lý Danh Sách Phát (Playlist Studio)</h2>
                    <p class="section-sub">Tạo danh sách nhạc cá nhân, dán hàng loạt bài hát và phát thẳng vào phòng voice</p>
                </div>
            </div>
            <div>
                <button class="btn btn-primary" onclick="openCreatePlaylistModal()">
                    ➕ Tạo Playlist Mới
                </button>
            </div>
