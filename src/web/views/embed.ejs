<!-- Toast Container -->
<div id="toast-container" class="toast-container"></div>

<!-- ====================================================
     FRONTEND JAVASCRIPT LOGIC
==================================================== -->
<script>
    let currentGuildId = "";
    let currentPlaylistName = "";
    let loopModeState = "off";

    window.addEventListener("DOMContentLoaded", () => {
        onGuildSelectChange();
        updateEmbedPreview();
        setInterval(fetchLiveState, 3500);
    });

    function showToast(message, type = "info") {
        const container = document.getElementById("toast-container");
        const toast = document.createElement("div");
        toast.className = `toast ${type}`;
        const icon = type === "success" ? "✅" : type === "error" ? "❌" : "ℹ️";
        toast.innerHTML = `<span>${icon}</span> <span>${message}</span>`;
        container.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = "0";
            toast.style.transform = "translateX(100%)";
            toast.style.transition = "all 0.3s ease";
            setTimeout(() => toast.remove(), 300);
        }, 4000);
    }

    function onGuildSelectChange() {
        const select = document.getElementById("player-guild-select");
        if (!select || !select.value) return;
        currentGuildId = select.value;

        const opt = select.options[select.selectedIndex];
        const channels = JSON.parse(opt.getAttribute("data-channels") || "[]");
        const is247 = opt.getAttribute("data-247") === "true";

        const btn247 = document.getElementById("btn-toggle-247-top");
        if (btn247) {
            btn247.textContent = is247 ? "🔴 Tắt Treo 24/7" : "🔒 Bật Treo 24/7";
            btn247.className = is247 ? "btn btn-danger btn-sm" : "btn btn-primary btn-sm";
        }

        const voiceSelect = document.getElementById("player-voice-select");
        voiceSelect.innerHTML = "";

        if (channels.length === 0) {
            voiceSelect.innerHTML = `<option value="">(Không có kênh voice)</option>`;
        } else {
            channels.forEach(vc => {
                const o = document.createElement("option");
                o.value = vc.id;
                o.textContent = `🔊 ${vc.name} (${vc.userCount} người)`;
                voiceSelect.appendChild(o);
            });
        }

        fetchLiveState();
    }

    async function fetchLiveState() {
        try {
            const res = await fetch("/api/music/state");
            const data = await res.json();
            if (!data.success) return;

            const guild = data.guilds.find(g => g.id === currentGuildId);
            if (!guild) return;

            const q = guild.activeQueue;
            const heroBox = document.getElementById("now-playing-box");
            const npBadge = document.getElementById("np-badge");
            const npTitle = document.getElementById("np-title");
            const npArtist = document.getElementById("np-artist");
            const npCover = document.getElementById("np-cover");
            const npCurrentTime = document.getElementById("np-time-current");
            const npTotalTime = document.getElementById("np-time-total");
            const npFill = document.getElementById("np-progress-fill");
            const loopBadge = document.getElementById("np-loop-badge");
            const playBtn = document.getElementById("ctrl-play-btn");

            if (q && q.isPlaying && q.currentTrack) {
                heroBox.classList.add("playing");
                npBadge.textContent = q.isPaused ? "⏸️ TẠM DỪNG" : "🟢 ĐANG PHÁT";
                npBadge.style.color = q.isPaused ? "#f59e0b" : "#34d399";
                npTitle.textContent = q.currentTrack.title;
                npArtist.textContent = `${q.currentTrack.author} • Kênh #${q.voiceChannelName || 'voice'}`;
                if (q.currentTrack.thumbnail) npCover.src = q.currentTrack.thumbnail;

                const curSec = q.currentSec || 0;
                const totSec = q.currentTrack.durationSec || 0;
                npCurrentTime.textContent = formatSec(curSec);
                npTotalTime.textContent = q.currentTrack.duration || formatSec(totSec);

                if (totSec > 0) {
                    const pct = Math.min(100, Math.round((curSec / totSec) * 100));
                    npFill.style.width = `${pct}%`;
                }

                loopModeState = q.loopMode || "off";
                loopBadge.textContent = `LẶP: ${loopModeState.toUpperCase()}`;
                playBtn.textContent = q.isPaused ? "▶️" : "⏸️";

                renderQueueTable(q.tracks || []);
            } else {
                heroBox.classList.remove("playing");
                npBadge.textContent = "⚪ KHÔNG PHÁT";
                npBadge.style.color = "#94a3b8";
                npTitle.textContent = "Chưa có bài hát nào đang phát";
                npArtist.textContent = "Chọn server và kênh voice để mở bài mới";
                npCurrentTime.textContent = "00:00";
                npTotalTime.textContent = "00:00";
                npFill.style.width = "0%";
                playBtn.textContent = "▶️";
                renderQueueTable([]);
            }
        } catch (_) {}
    }

    function formatSec(sec) {
        sec = Math.max(0, Math.floor(sec));
        const m = Math.floor(sec / 60);
        const s = sec % 60;
        return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
    }

    function renderQueueTable(tracks) {
        const tbody = document.getElementById("queue-tbody");
        document.getElementById("queue-count").textContent = tracks.length;

        if (tracks.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: var(--text-sub); padding: 30px;">Hàng đợi trống. Nhập bài hát để phát tiếp nối!</td></tr>`;
            return;
        }

        tbody.innerHTML = tracks.map((t, idx) => `
            <tr>
                <td class="queue-index">#${idx + 1}</td>
                <td><strong>${t.title}</strong><div style="font-size: 11.5px; color: var(--text-sub);">${t.author || 'Nghệ sĩ'}</div></td>
                <td><span style="font-family: var(--font-mono); font-size: 12px;">${t.duration || 'Live'}</span></td>
                <td><button class="btn btn-danger btn-sm" style="padding: 2px 8px;" onclick="removeQueueTrack(${idx + 1})">✕</button></td>
            </tr>
        `).join("");
    }

    // Voice Join & Leave Actions
    async function joinSelectedVoice() {
        const voiceSelect = document.getElementById("player-voice-select");
        const voiceChannelId = voiceSelect.value;
        if (!currentGuildId || !voiceChannelId) return showToast("Vui lòng chọn Server và Kênh Voice!", "error");

        try {
            const res = await fetch("/api/voice/join", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ guild_id: currentGuildId, voice_channel_id: voiceChannelId }),
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message, "success");
                fetchLiveState();
            } else {
                showToast(data.error || "Không thể vào voice", "error");
            }
        } catch (_) { showToast("Lỗi kết nối", "error"); }
    }

    async function leaveSelectedVoice() {
        if (!currentGuildId) return showToast("Vui lòng chọn Server!", "error");
        try {
            const res = await fetch("/api/voice/leave", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ guild_id: currentGuildId }),
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message, "success");
                fetchLiveState();
            } else {
                showToast(data.error || "Không thể rời voice", "error");
            }
        } catch (_) { showToast("Lỗi kết nối", "error"); }
    }

    async function toggle247FromVoiceHub() {
        const select = document.getElementById("player-guild-select");
        const opt = select.options[select.selectedIndex];
        const is247 = opt.getAttribute("data-247") === "true";
        const voiceSelect = document.getElementById("player-voice-select");
        const voiceChannelId = voiceSelect.value;

        showToast("Đang cập nhật trạng thái 24/7...", "info");
        try {
            const res = await fetch("/api/247/toggle", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    guild_id: currentGuildId,
                    voice_channel_id: voiceChannelId,
                    enabled: !is247,
                }),
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message, "success");
                setTimeout(() => location.reload(), 700);
            } else {
                showToast(data.error || "Thao tác thất bại", "error");
            }
        } catch (_) { showToast("Lỗi kết nối", "error"); }
    }

    // Music Player Controls
    async function controlMusic(action, extra = {}) {
        if (!currentGuildId) return showToast("Vui lòng chọn Server!", "error");
        try {
            const res = await fetch("/api/music/control", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ guild_id: currentGuildId, action, ...extra }),
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message, "success");
                fetchLiveState();
            } else {
                showToast(data.error || "Thao tác thất bại", "error");
            }
        } catch (_) { showToast("Lỗi kết nối", "error"); }
    }

    function togglePlayPause() {
        const btn = document.getElementById("ctrl-play-btn");
        const action = btn.textContent.includes("▶") ? "resume" : "pause";
        controlMusic(action);
    }

    function cycleLoopMode() {
        const modes = ["off", "track", "queue"];
        const next = modes[(modes.indexOf(loopModeState) + 1) % modes.length];
        controlMusic("loop", { mode: next });
    }

    function removeQueueTrack(index) {
        controlMusic("remove_track", { index });
    }

    function clearQueue() {
        if (!confirm("Bạn có chắc muốn xóa sạch toàn bộ hàng đợi?")) return;
        controlMusic("clear_queue");
    }

    async function handleQuickPlay(e) {
        e.preventDefault();
        const input = document.getElementById("quick-play-input");
        const voiceSelect = document.getElementById("player-voice-select");
        const query = input.value.trim();
        const voiceChannelId = voiceSelect.value;

        if (!currentGuildId || !voiceChannelId) {
            return showToast("Vui lòng chọn Server và Kênh Voice trước!", "error");
        }

        showToast("Đang tìm nạp và phát bài hát...", "info");
        try {
            const res = await fetch("/api/music/play", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    guild_id: currentGuildId,
                    voice_channel_id: voiceChannelId,
                    query,
                }),
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message, "success");
                input.value = "";
                fetchLiveState();
            } else {
                showToast(data.error || "Không thể phát bài hát", "error");
            }
        } catch (_) { showToast("Lỗi máy chủ", "error"); }
    }

    // Playlist Management Logic
    function openCreatePlaylistModal() {
        document.getElementById("modal-create-playlist").classList.add("active");
        document.getElementById("create-pl-name-input").focus();
    }

    function openBulkAddModal() {
        if (!currentPlaylistName) return showToast("Vui lòng chọn Playlist trước!", "error");
        document.getElementById("modal-bulk-add").classList.add("active");
        document.getElementById("bulk-add-textarea").focus();
    }

    function closeModal(id) {
        document.getElementById(id).classList.remove("active");
    }

    async function handleInlineCreatePlaylist(e) {
        e.preventDefault();
        const input = document.getElementById("inline-pl-name");
        const name = input.value.trim();
        if (!name) return;

        try {
            const res = await fetch("/api/playlists/create", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name }),
            });
            const data = await res.json();
            if (data.ok) {
                showToast(`Đã tạo playlist "${name}" thành công!`, "success");
                input.value = "";
                setTimeout(() => location.reload(), 700);
            } else {
                showToast(data.error || "Không thể tạo playlist", "error");
            }
        } catch (_) { showToast("Lỗi kết nối", "error"); }
    }

    async function handleModalCreatePlaylistSubmit(e) {
        e.preventDefault();
        const name = document.getElementById("create-pl-name-input").value.trim();
        if (!name) return;

        try {
            const res = await fetch("/api/playlists/create", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name }),
            });
            const data = await res.json();
            if (data.ok) {
                showToast(`Đã tạo playlist "${name}" thành công!`, "success");
                closeModal("modal-create-playlist");
                setTimeout(() => location.reload(), 700);
            } else {
                showToast(data.error || "Không thể tạo playlist", "error");
            }
        } catch (_) { showToast("Lỗi kết nối", "error"); }
    }

    async function loadPlaylistDetails(name) {
        currentPlaylistName = name;
        const detailCard = document.getElementById("playlist-detail-card");
        detailCard.style.display = "block";
        detailCard.scrollIntoView({ behavior: "smooth" });

        document.getElementById("pl-detail-title").textContent = `📜 Chi Tiết Danh Sách: ${name}`;

        try {
            const res = await fetch(`/api/playlists/${encodeURIComponent(name)}`);
            const data = await res.json();
            if (!data.success) return showToast("Không thể tải chi tiết playlist", "error");

            const pl = data.playlist;
            document.getElementById("pl-detail-meta").textContent = `Tổng số bài: ${pl.totalTracks} • Ngày tạo: ${pl.createdAt}`;

            const tbody = document.getElementById("pl-tracks-tbody");
            if (pl.tracks.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" style="text-align: center; color: var(--text-sub); padding: 30px;">Danh sách chưa có bài hát nào! Nhập link bên trên để thêm bài.</td></tr>`;
            } else {
                tbody.innerHTML = pl.tracks.map(t => `
                    <tr>
                        <td class="queue-index">#${t.index}</td>
                        <td><code>${t.query}</code></td>
                        <td><button class="btn btn-danger btn-sm" style="padding: 2px 8px;" onclick="removePlaylistTrack('${t.index}')">✕</button></td>
                    </tr>
                `).join("");
            }
        } catch (_) { showToast("Lỗi khi tải playlist", "error"); }
    }

    async function handleAddTrackToPlaylist(e) {
        e.preventDefault();
        if (!currentPlaylistName) return;
        const input = document.getElementById("add-track-input");
        const song = input.value.trim();
        if (!song) return;

        try {
            const res = await fetch("/api/playlists/add", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: currentPlaylistName, song }),
            });
            const data = await res.json();
            if (data.ok) {
                showToast(data.message, "success");
                input.value = "";
                loadPlaylistDetails(currentPlaylistName);
            } else {
                showToast(data.error || "Không thể thêm bài", "error");
            }
        } catch (_) { showToast("Lỗi khi thêm bài", "error"); }
    }

    async function handleBulkAddSubmit(e) {
        e.preventDefault();
        if (!currentPlaylistName) return;
        const text = document.getElementById("bulk-add-textarea").value.trim();
        if (!text) return;

        try {
            const res = await fetch("/api/playlists/add", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: currentPlaylistName, songs: text }),
            });
            const data = await res.json();
            if (data.ok) {
                showToast(data.message, "success");
                closeModal("modal-bulk-add");
                document.getElementById("bulk-add-textarea").value = "";
                loadPlaylistDetails(currentPlaylistName);
            } else {
                showToast(data.error || "Lỗi lưu danh sách", "error");
            }
        } catch (_) { showToast("Lỗi kết nối", "error"); }
    }

    async function removePlaylistTrack(index) {
        if (!currentPlaylistName) return;
        try {
            const res = await fetch("/api/playlists/remove", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: currentPlaylistName, index }),
            });
            const data = await res.json();
            if (data.ok) {
                showToast(data.message, "success");
                loadPlaylistDetails(currentPlaylistName);
            } else {
                showToast(data.error || "Không thể xóa bài", "error");
            }
        } catch (_) { showToast("Lỗi khi xóa bài", "error"); }
    }

    async function deletePlaylistPrompt(name) {
        if (!confirm(`Bạn có chắc chắn muốn xóa vĩnh viễn playlist "${name}"?`)) return;
        try {
            const res = await fetch("/api/playlists/delete", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name }),
            });
            const data = await res.json();
            if (data.ok) {
                showToast(data.message, "success");
                setTimeout(() => location.reload(), 600);
            } else {
                showToast(data.error || "Không thể xóa playlist", "error");
            }
        } catch (_) { showToast("Lỗi khi xóa playlist", "error"); }
    }

    function deleteCurrentPlaylist() {
        if (currentPlaylistName) deletePlaylistPrompt(currentPlaylistName);
    }

    function quickPlayPlaylist(name) {
        currentPlaylistName = name;
        playCurrentPlaylist('or');
    }

    async function playCurrentPlaylist(mode = "or") {
        if (!currentPlaylistName) return showToast("Vui lòng chọn Playlist!", "error");
        const voiceSelect = document.getElementById("player-voice-select");
        const voiceChannelId = voiceSelect.value;

        if (!currentGuildId || !voiceChannelId) {
            return showToast("Vui lòng chọn Server và Kênh Voice ở Phần 1 trước!", "error");
        }

        showToast(`Đang phát playlist "${currentPlaylistName}"...`, "info");
        try {
            const res = await fetch("/api/playlists/play", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    guild_id: currentGuildId,
                    voice_channel_id: voiceChannelId,
                    playlist_name: currentPlaylistName,
                    mode,
                }),
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message, "success");
                document.getElementById("sec-voice").scrollIntoView({ behavior: "smooth" });
                fetchLiveState();
            } else {
                showToast(data.error || "Không thể phát playlist", "error");
            }
        } catch (_) { showToast("Lỗi kết nối", "error"); }
    }

    // Embed Dispatcher
    function updateEmbedPreview() {
        const title = document.getElementById("embed-title").value.trim();
        const desc = document.getElementById("embed-desc").value.trim();
        const color = document.getElementById("embed-color").value;
        const author = document.getElementById("embed-author").value.trim();
        const image = document.getElementById("embed-image").value.trim();

        const pvBox = document.getElementById("preview-box");
        const pvTitle = document.getElementById("pv-title");
        const pvDesc = document.getElementById("pv-desc");
        const pvAuthor = document.getElementById("pv-author");
        const pvImage = document.getElementById("pv-image");

        pvBox.style.borderLeftColor = color;
        pvTitle.textContent = title || "Tiêu đề thông báo mẫu";
        pvDesc.textContent = desc || "Nội dung chi tiết thông báo sẽ hiển thị tại đây...";

        if (author) {
            pvAuthor.textContent = author;
            pvAuthor.style.display = "block";
        } else { pvAuthor.style.display = "none"; }

        if (image && image.startsWith("http")) {
            pvImage.src = image;
            pvImage.style.display = "block";
        } else { pvImage.style.display = "none"; }
    }

    async function handleSendEmbed(e) {
        e.preventDefault();
        const channel_id = document.getElementById("embed-channel-select").value;
        const title = document.getElementById("embed-title").value;
        const description = document.getElementById("embed-desc").value;
        const color = document.getElementById("embed-color").value;
        const author_name = document.getElementById("embed-author").value;
        const thumbnail_url = document.getElementById("embed-thumb").value;
        const image_url = document.getElementById("embed-image").value;

        showToast("Đang gửi Embed vào Discord...", "info");
        try {
            const res = await fetch("/api/embed/send", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    channel_id,
                    title,
                    description,
                    color,
                    author_name,
                    thumbnail_url,
                    image_url,
                }),
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message, "success");
            } else {
                showToast(data.error || "Gửi Embed thất bại", "error");
            }
        } catch (_) { showToast("Lỗi máy chủ", "error"); }
    }
</script>
</body>
</html>
