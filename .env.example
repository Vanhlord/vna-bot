# ========================================================
# VNA MUSIC BOT - CẤU HÌNH BOT MỚI (.ENV)
# ========================================================

# 1. Token của Bot Discord Mới (Lấy tại https://discord.com/developers/applications)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# 2. Application ID (Client ID) của Bot mới
CLIENT_ID=YOUR_CLIENT_ID_HERE

# 3. Âm lượng mặc định khi mở bài (1 đến 100)
DEFAULT_VOLUME=70

# 4. Thời gian chờ (giây) trước khi bot tự rời phòng khi tắt 24/7 (mặc định 180 giây = 3 phút)
IDLE_TIMEOUT_SECONDS=180

# 5. Tự động rời phòng voice khi phòng trống (áp dụng khi tắt 24/7)
AUTO_LEAVE_ON_EMPTY=true

# 6. Dashboard web (nên để false khi host bot ra Internet)
WEB_ENABLED=false

# Chỉ dùng khi WEB_ENABLED=true. Cổng và địa chỉ lắng nghe dashboard.
WEB_PORT=3003
WEB_HOST=127.0.0.1

# 7. Server Discord dùng để đăng ký lệnh tức thì khi phát triển (để trống để đăng ký toàn cầu)
DEV_GUILD_ID=

# 8. (Tùy chọn) Đường dẫn binary khi host trên VPS/Docker. Bỏ trống để bot tự tìm/tải.
# Ví dụ trên Linux: YTDLP_PATH=/usr/bin/yt-dlp và FFMPEG_PATH=/usr/bin/ffmpeg
YTDLP_PATH=
FFMPEG_PATH=

# 9. (Tùy chọn) Cổng HTTP do hosting cấp phát (Railway/Render/Replit...).
# Nếu hosting có biến PORT, bot sẽ tự dùng cho dashboard khi WEB_ENABLED=true.
# PORT=3003
