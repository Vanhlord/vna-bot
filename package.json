{
  "name": "vna-music-bot",
  "version": "1.0.0",
  "description": "Commercial-grade, high-performance, 5-star Discord Music Bot with Hybrid Audio Resolver (play-dl + yt-dlp) and Autocomplete /play.",
  "main": "index.js",
  "packageManager": "npm@10.0.0",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
