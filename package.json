  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.21.0",
    "dotenv": "^17.3.1",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "spotify-url-info": "^3.3.3",
    "undici": "^6.23.0",
    "ws": "^8.18.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
